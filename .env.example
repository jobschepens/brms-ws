# BRMS Workshop Environment Configuration Template
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# RStudio login password
RSTUDIO_PASSWORD=workshop

# Host user ID to match file permissions on Linux/macOS
RSTUDIO_USERID=1000

# Allow root (sudo) access inside the container (true/false)
RSTUDIO_ROOT=false

# Optional: Container timezone (e.g. Europe/Berlin, Europe/Brussels, America/New_York)
# TZ=Europe/Berlin

# Note on Volume Mounts:
# docker-compose.yml mounts local directories for development, including collaborator
# workspaces located in parent directories (../vicom-4lang, ../temp/katja, ../samplesize, ../cont).
# If running on a new machine where these folders do not exist, Docker Desktop will create
# empty placeholders, or you can comment them out in docker-compose.yml if not needed.